MOCK_MODE=false

# Quantos workers cada estágio pode ter (mín/máx) fica em supervisor.toml —
# o crevomq-supervisor escala entre eles conforme o backlog.

# Filas (CrevoMQ): banco próprio, separado do contos.db.
FILA_DB_PATH=data/fila.db
CREVOMQ_URL=http://127.0.0.1:8420

# Site de origem (URL base, sem barra no fim). Vazio = só MOCK_MODE funciona.
SITE_BASE_URL=
# Opcional; padrão = SITE_BASE_URL + /static/sitemap.index.xml.gz
SITEMAP_INDEX_URL=

# Descarte (descarte.py): regex sobre cada tag normalizada (minúsculas, sem
# acento). DESCARTE_TAGS é obrigatório para rodar o descarte; uma tag que case
# com DESCARTE_PROTEGIDAS salva o texto. Use aspas simples.
DESCARTE_TAGS=
DESCARTE_PROTEGIDAS=

# Recorte de descoberta (meses pra trás a partir de hoje); 0 = sitemap
# inteiro, sem limite de data (base completa, ~250 mil textos — só faça isso
# de propósito, é uma coleta de dias, não de horas).
DESCOBERTA_MESES=0

# Só mude se souber o que está fazendo — ver plan.md sobre boa convivência
# com o site (intervalo entre requisições, User-Agent identificável).
REQUEST_INTERVAL_SECONDS=1.5
USER_AGENT=textos-similares/0.1 (uso pessoal; +https://github.com/)

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
QDRANT_COLLECTION=contos
# Tentativas por estágio antes de o job ficar em 'erro' (backoff exponencial
# entre elas, pelo CrevoMQ). LOTE_PADRAO: jobs por rodada em scraper/rodar.py.
MAX_TENTATIVAS=5
LOTE_PADRAO=50

# --- Busca v2 e resumos (busca_v2/) ---
# amostra = só os primeiros BUSCA_V2_LIMITE textos extraídos (coleção/estado
# separados); completo = base inteira, só roda com a extração terminada.
BUSCA_V2_MODO=amostra
BUSCA_V2_LIMITE=2000
EMBEDDING_MODEL_V2=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TRECHO_TOKENS=400
TRECHO_SOBREPOSICAO=50
TRECHOS_MAX_POR_TEXTO=0
# Obrigatório: trechos de tag (separados por vírgula) excluídos da busca v2/resumos
TEMAS_EXCLUIDOS=
# mock = sem rede; openai = qualquer servidor compatível (llama-server, Ollama, vLLM)
LLM_PROVEDOR=mock
LLM_URL=http://localhost:8080/v1
LLM_MODELO=qwen3-4b
LLM_MAX_CHARS=12000

# Leitura em voz alta (Fase 11) — modelo em TTS_MODELO_DIR: `uv run python scripts/baixar_voz.py`
TTS_MOTOR=kokoro
TTS_VOZ=pf_dora
TTS_MODELO=kokoro-v1.0.fp16.onnx
TTS_PARALELO=2
TTS_VELOCIDADE=1.0
TTS_CACHE_MAX_GB=5
